<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sermons_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_soft">

    <LinearLayout
        android:id="@+id/sermons_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <!-- 16:9 Hero media card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hero_media"
            style="@style/UiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp"
            app:contentPadding="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minHeight="200dp">
                <ImageView
                    android:id="@+id/hero_media_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_lazarus"
                    android:alpha="0.85" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="bottom"
                    android:padding="16dp"
                    android:background="@drawable/gradient_bottom_dark">
                    <TextView
                        android:id="@+id/media_hero_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baal Perazim — The God of the Breakthrough"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:id="@+id/media_hero_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bishop Dr. David Mutweri · Embu Headquarters"
                        android:textSize="13sp"
                        android:textColor="#F5ECF7"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />
                    <ImageButton
                        android:id="@+id/btn_play_hero"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/pill_orange_bg"
                        android:src="@drawable/ic_video_camera"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sermon list — 64dp thumbnails + stacked meta -->
        <TextView
            android:id="@+id/sermons_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUNDAY SERMONS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#581665"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sermon_1"
            style="@style/UiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/thumb_1"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_lazarus_classical"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/title_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The God of the Breakthrough — Series 1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#140319"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:id="@+id/meta_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bishop Dr. David Mutweri · 42 min · Embu HQ"
                        android:textSize="12sp"
                        android:textColor="#725B78"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:id="@+id/duration_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42:00"
                        android:textSize="10sp"
                        android:textColor="#DE6F26"
                        android:background="@drawable/pill_amber_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sermon_2"
            style="@style/UiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/thumb_2"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_hymn"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/title_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Worship in the Sanctuary — Part 2"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#140319"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:id="@+id/meta_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Midweek Service · 5:30 PM · Embu HQ"
                        android:textSize="12sp"
                        android:textColor="#725B78"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:id="@+id/duration_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28:15"
                        android:textSize="10sp"
                        android:textColor="#DE6F26"
                        android:background="@drawable/pill_amber_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    
        <!-- Additional Sermon card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sermon_3"
            style="@style/UiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/thumb_3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_lazarus_classical"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/title_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The God of the Breakthrough — Series 3"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#140319"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:id="@+id/meta_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bishop Dr. David Mutweri · 45 min · Embu HQ"
                        android:textSize="12sp"
                        android:textColor="#725B78"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:id="@+id/duration_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45:00"
                        android:textSize="10sp"
                        android:textColor="#DE6F26"
                        android:background="@drawable/pill_amber_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
</ScrollView>
