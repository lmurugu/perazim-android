<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/worship_scroll" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/bg_soft">
    <LinearLayout android:id="@+id/worship_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp"
        android:animateLayoutChanges="true">
        <!-- Hymn card with expandable lyrics -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hymn"
            style="@style/UiCard" android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF" app:cardElevation="3dp"
            app:cardCornerRadius="16dp" app:contentPadding="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:id="@+id/icon_music" android:layout_width="24dp"
                        android:layout_height="24dp" android:src="@drawable/ic_music_note"
                        android:tint="#581665" />
                    <TextView android:id="@+id/hymn_title"
                        android:layout_marginStart="8dp"
                        android:text="Amazing Grace — Hymn 47" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#140319"
                        android:fontFamily="sans-serif-black" android:layout_weight="1" />
                    <ImageButton android:id="@+id/btn_expand_lyrics"
                        android:layout_width="36dp" android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_smiley" android:tint="#DE6F26" />
                </LinearLayout>
                <TextView android:id="@+id/hymn_lyrics"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Amazing grace, how sweet the sound..."
                    android:textSize="14sp" android:fontFamily="serif"
                    android:textStyle="italic" android:textColor="#140319"
                    android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Additional Hymn card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hymn_2"
            style="@style/UiCard"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp"
            app:cardCornerRadius="16dp"
            app:contentPadding="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:id="@+id/icon_music_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_music_note"
                        android:tint="#581665" />
                    <TextView android:id="@+id/hymn_title_2"
                        android:layout_marginStart="8dp"
                        android:text="Great Is Thy Faithfulness — Hymn 123"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#140319"
                        android:fontFamily="sans-serif-black"
                        android:layout_weight="1" />
                    <ImageButton android:id="@+id/btn_expand_lyrics_2"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_smiley"
                        android:tint="#DE6F26" />
                </LinearLayout>
                <TextView android:id="@+id/hymn_lyrics_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Great is thy faithfulness, O God..."
                    android:textSize="14sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:textColor="#140319"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Worship session pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_worship_pill"
            style="@style/UiCard" android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FDF5EF" app:cardElevation="2dp"
            app:cardCornerRadius="16dp" app:contentPadding="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/worship_session"
                    android:text="SUNDAY MORNING WORSHIP · LIVE STREAM — 9:00 AM"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="#DE6F26" android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06" />
                <TextView android:id="@+id/worship_desc"
                    android:text="Join Bishop Dr. David Mutweri for revival worship. Praise, prayer, and breakthrough songs."
                    android:textSize="13sp" android:textColor="#334155"
                    android:layout_marginTop="6dp" />
                <Button android:id="@+id/btn_watch_worship"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="10dp" android:text="Watch Live"
                    android:textColor="#FFFFFF" android:textSize="14sp"
                    android:fontFamily="sans-serif-black" android:background="@drawable/pill_orange_bg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
