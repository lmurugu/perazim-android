<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_soft"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:animateLayoutChanges="true">

        <!-- Hero banner — 16:9 proportion, gradient surface -->
        <FrameLayout
            android:id="@+id/hero_banner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:minHeight="180dp"
            android:background="@drawable/hero_gradient"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:outlineSpotShadowColor="#DE6F26"
            android:outlineAmbientShadowColor="#DE6F26">

            <ImageView
                android:id="@+id/hero_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/hero_sanctuary"
                android:alpha="0.35" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_gravity="bottom">

                <TextView
                    android:id="@+id/hero_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BAAL-PERAZIM"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#DE6F26"
                    android:background="@drawable/pill_orange_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The God of the Breakthrough"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/hero_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 Samuel 5:20 — Perazim Mission Church · Embu, Kenya"
                    android:textSize="13sp"
                    android:textColor="#F5ECF7"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Verse of the Day — scripture card with serif italic -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UiCard"
            android:id="@+id/card_verse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp"
            app:cardCornerRadius="16dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/verse_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 VERSE OF THE DAY · 2 SAMUEL 5:20"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#DE6F26"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/verse_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="“As waters break out, the LORD has broken out against my enemies before me — therefore he named that place Baal Perazim.”"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:textSize="17sp"
                    android:textColor="#140319"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/verse_reflection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theme: The God of the Breakthrough. Ready to break every barrier before you this season."
                    android:textSize="12sp"
                    android:textColor="#725B78"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <Button
                        android:id="@+id/btn_reflect"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Reflect"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/pill_purple_bg"
                        android:layout_marginEnd="4dp" />
                    <Button
                        android:id="@+id/btn_pray"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Pray (+10 XP)"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/pill_orange_bg"
                        android:layout_marginEnd="4dp" />
                    <Button
                        android:id="@+id/btn_share"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Share Verse"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/pill_purple_dark_bg"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Breakthrough Quest -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UiCard"
            android:id="@+id/card_quest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/quest_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ TODAY'S BREAKTHROUGH QUEST"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#DE6F26"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04" />
                <TextView
                    android:id="@+id/quest_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Read 1 Chapter &amp; Spend 5 mins in Prayer to claim your daily breakthrough reward!"
                    android:textSize="13sp"
                    android:textColor="#334155"
                    android:layout_marginTop="4dp" />
                <ProgressBar
                    android:id="@+id/progress_quest"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:progress="80"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_orange_purple" />
                <Button
                    android:id="@+id/btn_quest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Complete Quest (+50 XP)"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/pill_orange_bg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats pills row -->
        <LinearLayout
            android:id="@+id/stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">
            <include layout="@layout/pill_stat_streak" />
            <include layout="@layout/pill_stat_xp" />
            <include layout="@layout/pill_stat_grace" />
        </LinearLayout>

        <!-- Sermons teaser -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UiCard"
            android:id="@+id/card_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:contentPadding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/media_title" android:text="📖 Sunday Sermons &amp; Teachings"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#140319" android:fontFamily="sans-serif-black" />
                <TextView android:id="@+id/media_sub" android:text="Under Bishop Dr. David Mutweri. Access revival messages, doctrines, seminar series."
                    android:textSize="13sp" android:textColor="#725B78" android:layout_marginTop="4dp" />
                <Button android:id="@+id/btn_media" android:text="Explore Sermons"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="10dp" android:textColor="#FFFFFF"
                    android:textSize="13sp" android:fontFamily="sans-serif-medium"
                    android:background="@drawable/pill_purple_bg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Visit card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UiCard"
            android:id="@+id/card_visit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:contentPadding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/visit_title" android:text="📍 Plan a Visit (Embu Headquarters)"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#140319" android:fontFamily="sans-serif-black" />
                <TextView android:id="@+id/visit_sub"
                    android:text="Services: Sun 9:00 AM &amp; 11:30 AM · Wed Midweek 5:30 PM. Embu, Kenya. You are warmly welcome!"
                    android:textSize="13sp" android:textColor="#725B78" android:layout_marginTop="4dp" />
                <Button android:id="@+id/btn_visit"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="10dp" android:text="View Campus Info"
                    android:textColor="#FFFFFF" android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" android:background="@drawable/pill_orange_bg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
