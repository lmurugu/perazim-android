<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto"
    android:versionCode="3"
    android:versionName="2.1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- WhatsApp -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Safaricom M-Pesa -->
        <package android:name="com.safaricom.mpesa.lifestyle" />
        <package android:name="com.safaricom.mpesa" />
        <!-- SIM Toolkit -->
        <package android:name="com.android.stk" />
        <package android:name="com.android.stk2" />
        <package android:name="com.mediatek.stkselection" />
        <!-- YouTube -->
        <package android:name="com.google.android.youtube" />
        <!-- Google Maps -->
        <package android:name="com.google.android.apps.maps" />
        <!-- System intent resolvers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:label="Perazim"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">
        <activity
            android:name=".MainActivity"
            android:label="Perazim"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReflectionsActivity"
            android:label="Reflections"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SermonsActivity"
            android:label="Sermons"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HymnsActivity"
            android:label="Hymns"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".RiddlesActivity"
            android:label="Riddles"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".JokesActivity"
            android:label="Jokes"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
