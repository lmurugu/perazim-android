# Google Sheet Published CSV Tab URLs for Perazim Church Content Master
# Format: https://docs.google.com/spreadsheets/d/e/<SPREADSHEET_ID>/pub?gid=<TAB_GID>&single=true&output=csv
#
# Levi sends the 8 URLs in chat and Antigravity enters them.
# If these properties are empty, each tab uses the shared church content feed
# (BuildConfig.CONTENT_FEED_BASE_URL + "/csv/<tab>.csv"); see docs/CONTENT_GUIDE.md.
# Nothing is downloaded while REMOTE_SHEET_FEEDS_ENABLED is false; the app then
# uses its local pre-seeded database content.

sheet_url_announcements=
sheet_url_events=
sheet_url_hymns=
sheet_url_riddles=
sheet_url_jokes=
sheet_url_sermons=
sheet_url_verses=
sheet_url_config=
